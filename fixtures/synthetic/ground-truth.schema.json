{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "synthetic-ground-truth",
  "description": "Machine-readable ground truth for the deterministic local evaluation site. URLs are server-relative; the evaluator resolves them against the fixture base URL.",
  "type": "object",
  "required": ["version", "cases"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "page", "notes"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["positive", "negative", "structural"] },
          "page": { "type": "string" },
          "selector": { "type": "string" },
          "techniques": {
            "type": "array",
            "items": { "type": "string", "enum": ["HOMOGLYPH", "JAMO", "TRANSPARENT", "OFFSCREEN"] }
          },
          "framePath": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["src", "selector"],
              "properties": {
                "src": { "type": "string" },
                "selector": { "type": "string" }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
