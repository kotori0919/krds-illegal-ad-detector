{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "불법광고 탐지 도구",
  "version": "0.1.0",
  "identifier": "kr.go.nia.illegal-ad-detector",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -w apps/web",
    "beforeBuildCommand": "npm run build -w apps/web && npm run build:sidecar && npm run prepare:windows-runtime"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "languages": [
          "Korean",
          "English"
        ]
      }
    },
    "resources": {
      "binaries/scanner-worker-x86_64-pc-windows-gnu.mjs": "binaries/scanner-worker-x86_64-pc-windows-gnu.mjs",
      "binaries/ocr-worker.mjs": "binaries/ocr-worker.mjs",
      "binaries/ocr-data/": "binaries/ocr-data/",
      "binaries/node.exe": "binaries/node.exe",
      "binaries/node-LICENSE": "binaries/node-LICENSE",
      "binaries/node_modules/": "binaries/node_modules/",
      "binaries/ms-playwright/": "binaries/ms-playwright/"
    }
  }
}
