{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Main-window capability: scanner lifecycle + event + export.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-text-file"
  ]
}
